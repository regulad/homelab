#!/usr/bin/env bash
# Run a command (ansible or ansible-playbook) with each Cisco SG300's
# svc-ansible key loaded into a throwaway ssh-agent, never written to disk.
# The keys come from inventory/host_vars/<switch>/secrets.sops.yml for every
# host in the ciscosmb group. OpenSSL's security level is lowered for this
# command alone (openssl-legacy.cnf), for the agent's SHA-1 signatures and
# libssh's legacy key exchange. Run from ansible-hardware/:
#   bin/with-switch-keys ansible-playbook playbooks/site.yml --limit ciscosmb
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
export OPENSSL_CONF="$here/openssl-legacy.cnf"

# A short private directory: a Unix socket path must stay under ~100 bytes.
dir=$(mktemp -d /tmp/with-switch-keys.XXXXXX)
eval "$(ssh-agent -a "$dir/agent" -s)" >/dev/null
trap 'ssh-agent -k >/dev/null; rm -rf "$dir"' EXIT

hosts=$(ansible-inventory --list | jq -r '.ciscosmb.hosts[]?')
[ -n "$hosts" ] || { echo "with-switch-keys: no hosts in the ciscosmb group" >&2; exit 1; }
for host in $hosts; do
  sops decrypt --extract '["svc_ansible_private_key"]' \
    "$here/../inventory/host_vars/$host/secrets.sops.yml" | ssh-add -q -
  # The switches accept an SSH connection only once something has pinged them.
  ping -c 2 -W 2 "$host.regulad.internal" >/dev/null || true
done

"$@"
