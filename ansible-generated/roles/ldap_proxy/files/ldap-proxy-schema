#!/usr/bin/python3
"""Write an OpenLDAP schema file for an LDAP proxy from its remote's schema.

slapd's ldap backend must know every attribute and object class a filter
names, or it searches for nothing, and rwm rewrites DNs only in attributes it
knows hold DNs. This reads the remote's subschema, starts a throwaway slapd with
OpenLDAP's standard schemas to learn what it already knows (built-ins
included), and writes the rest: unknown syntaxes become Directory String,
unknown matching rules are dropped, and each definition follows what it
derives from. slaptest then checks the file, and any definition it rejects is
left out. Prints "changed" when the output file changes.
"""
import argparse
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time

# Ubuntu's AppArmor profile for slapd, which slaptest shares, lets it read and
# write /var/tmp, but not /tmp or most of /run/slapd.
WORK_DIR = "/var/tmp"

STANDARD = ["core", "cosine", "inetorgperson", "nis"]
DIRECTORY_STRING = "1.3.6.1.4.1.1466.115.121.1.15"


def search(uri, base, attrs, env=None):
    out = subprocess.run(
        ["ldapsearch", "-LLL", "-x", "-o", "ldif-wrap=no", "-H", uri, "-b", base, "-s", "base",
         "(objectClass=*)"] + attrs,
        check=True, capture_output=True, text=True, env=env).stdout
    values = {a.lower(): [] for a in attrs}
    for line in out.splitlines():
        name, sep, value = line.partition(": ")
        if sep and name.lower() in values:
            values[name.lower()].append(value)
    return values


def oid(definition):
    return definition.strip()[1:].split()[0]


def names(definition):
    m = re.search(r"\bNAME\s+(\(([^)]*)\)|'([^']*)')", definition)
    if not m:
        return []
    return [n.lower() for n in re.findall(r"'([^']*)'", m.group(1))]


def field(definition, key):
    m = re.search(r"\b" + key + r"\s+(\([^)]*\)|\S+)", definition)
    return m.group(1) if m else None


def oids_in(value):
    return [v.strip("'").lower() for v in re.split(r"[\s$()]+", value or "") if v and v != "$"]


def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def local_schema(slapd_dir):
    """Start slapd with the standard schemas only; return what it knows.

    It listens on a loopback port rather than a socket, which AppArmor's
    profile for slapd allows anywhere.
    """
    tmp = tempfile.mkdtemp(prefix="ldap-proxy-schema.", dir=WORK_DIR)
    try:
        conf = os.path.join(tmp, "slapd.conf")
        with open(conf, "w") as f:
            for s in STANDARD:
                f.write(f"include {slapd_dir}/schema/{s}.schema\n")
            f.write(f"pidfile {tmp}/pid\nargsfile {tmp}/args\n")
        uri = f"ldap://127.0.0.1:{free_port()}"
        proc = subprocess.Popen(["slapd", "-d", "0", "-f", conf, "-h", uri],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            for _ in range(50):
                try:
                    return search(uri, "cn=Subschema", ["attributeTypes", "objectClasses", "ldapSyntaxes", "matchingRules"])
                except subprocess.CalledProcessError:
                    time.sleep(0.1)
            sys.exit("the throwaway slapd did not answer")
        finally:
            proc.terminate()
            proc.wait(timeout=10)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def known(definitions):
    ids = set()
    for d in definitions:
        ids.add(oid(d).lower())
        ids.update(names(d))
    return ids


def adapt_attribute(d, syntaxes, rules):
    m = re.search(r"\bSYNTAX\s+'?([0-9.]+)(\{\d+\})?'?", d)
    if m and m.group(1) not in syntaxes:
        d = d[:m.start()] + "SYNTAX " + DIRECTORY_STRING + d[m.end():]
    for key in ("EQUALITY", "ORDERING", "SUBSTR"):
        m = re.search(r"\b" + key + r"\s+(\S+)", d)
        if m and m.group(1).lower() not in rules:
            d = d[:m.start()] + d[m.end():]
    return re.sub(r"\s+", " ", d).strip()


def ordered(defs, local_ids):
    """Each definition after the ones its SUP names, among those written."""
    by_id = {}
    for d in defs:
        for k in [oid(d).lower()] + names(d):
            by_id[k] = d
    done, out = set(), []

    def visit(d, depth=0):
        if id(d) in done or depth > 50:
            return
        for sup in oids_in(field(d, "SUP")):
            if sup in by_id and sup not in local_ids:
                visit(by_id[sup], depth + 1)
        done.add(id(d))
        out.append(d)

    for d in defs:
        visit(d)
    return out


def render(attrs, classes):
    lines = ["# Generated by ldap-proxy-schema from the remote's subschema; do not edit."]
    lines += [f"attributetype {a}" for a in attrs]
    lines += [f"objectclass {c}" for c in classes]
    return "\n".join(lines) + "\n"


def slaptest(slapd_dir, schema_text):
    tmp = tempfile.mkdtemp(prefix="ldap-proxy-schema.", dir=WORK_DIR)
    try:
        path = os.path.join(tmp, "remote.schema")
        with open(path, "w") as f:
            f.write(schema_text)
        conf = os.path.join(tmp, "slapd.conf")
        with open(conf, "w") as f:
            for s in STANDARD:
                f.write(f"include {slapd_dir}/schema/{s}.schema\n")
            f.write(f"include {path}\n")
        r = subprocess.run(["slaptest", "-u", "-f", conf], capture_output=True, text=True)
        if r.returncode == 0:
            return None
        m = re.search(re.escape(path) + r": line (\d+)", r.stdout + r.stderr)
        return int(m.group(1)) if m else -1
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--uri", required=True)
    p.add_argument("--cacert", required=True)
    p.add_argument("--output", required=True)
    p.add_argument("--slapd-dir", default="/etc/ldap")
    a = p.parse_args()
    os.makedirs(WORK_DIR, exist_ok=True)

    env = dict(os.environ, LDAPTLS_CACERT=a.cacert, LDAPTLS_REQCERT="demand")
    remote = search(a.uri, "cn=schema", ["attributeTypes", "objectClasses"], env)
    local = local_schema(a.slapd_dir)
    local_ids = known(local["attributetypes"] + local["objectclasses"])
    syntaxes = {oid(s) for s in local["ldapsyntaxes"]}
    rules = known(local["matchingrules"])

    attrs = [adapt_attribute(d, syntaxes, rules) for d in remote["attributetypes"]
             if not ({oid(d).lower()} | set(names(d))) & local_ids]
    classes = [re.sub(r"\s+", " ", d).strip() for d in remote["objectclasses"]
               if not ({oid(d).lower()} | set(names(d))) & local_ids]
    all_ids = local_ids | known(attrs)
    trimmed = []
    for c in classes:
        for key in ("MUST", "MAY"):
            value = field(c, key)
            if value:
                kept = [n for n in oids_in(value) if n in all_ids]
                repl = (key + " ( " + " $ ".join(kept) + " )") if kept else ""
                c = c.replace(key + " " + value, repl, 1)
        trimmed.append(re.sub(r"\s+", " ", c).strip())
    attrs = ordered(attrs, local_ids)
    classes = ordered(trimmed, local_ids | known(attrs))

    dropped = 0
    while True:
        text = render(attrs, classes)
        bad = slaptest(a.slapd_dir, text)
        if bad is None:
            break
        if bad < 2 or dropped > 500:
            sys.exit(f"slaptest rejects the generated schema (line {bad})")
        index = bad - 2  # line 1 is the comment
        if index < len(attrs):
            attrs.pop(index)
        else:
            classes.pop(index - len(attrs))
        dropped += 1

    old = open(a.output).read() if os.path.exists(a.output) else None
    if old != text:
        tmp = a.output + ".new"
        with open(tmp, "w") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, a.output)
        print("changed")
    print(f"{len(attrs)} attribute types, {len(classes)} object classes, {dropped} left out", file=sys.stderr)


main()
