# Managed by Ansible (freeradius), in {{ freeradius_mode }} mode.
server homelab {
	listen {
		type = auth
		ipaddr = *
		port = 0
	}

	listen {
		type = auth
		ipv6addr = ::
		port = 0
	}

	listen {
		type = acct
		ipaddr = *
		port = 0
	}

	listen {
		type = acct
		ipv6addr = ::
		port = 0
	}

	authorize {
		preprocess
{% if freeradius_mode == 'proxy' %}
		update control {
			&Proxy-To-Realm := "home"
		}
{% else %}
		ldap
		if ((ok || updated) && User-Password) {
			update control {
				&Auth-Type := ldap
			}
		}
{% endif %}
	}

	authenticate {
{% if freeradius_mode == 'ldap' %}
		Auth-Type LDAP {
			ldap
		}
{% endif %}
	}

	preacct {
		preprocess
{% if freeradius_mode == 'proxy' %}
		update control {
			&Proxy-To-Realm := "home"
		}
{% endif %}
	}

	accounting {
		ok
	}

	post-auth {
		Post-Auth-Type REJECT {
			attr_filter.access_reject
		}
	}
}
