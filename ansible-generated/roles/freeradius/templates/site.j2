# Managed by Ansible (freeradius).
server homelab {
	listen {
		type = auth
		ipaddr = *
		port = 0
	}

	listen {
		type = auth
		ipv6addr = ::
		port = 0
	}

	listen {
		type = acct
		ipaddr = *
		port = 0
	}

	listen {
		type = acct
		ipv6addr = ::
		port = 0
	}

	authorize {
		preprocess
		ldap
		if ((ok || updated) && User-Password) {
			update control {
				&Auth-Type := ldap
			}
		}
	}

	authenticate {
		Auth-Type LDAP {
			ldap
		}
	}

	preacct {
		preprocess
	}

	accounting {
		ok
	}

	post-auth {
		Post-Auth-Type REJECT {
			attr_filter.access_reject
		}
	}
}
