[Unit]
Description={{ item.description }}
{% if item.after | default([]) %}
After={{ item.after | join(' ') }}
{% endif %}
{% if item.wants | default([]) %}
Wants={{ item.wants | join(' ') }}
{% endif %}

[Container]
Image={{ item.image }}
{% if item.container_name is defined %}
ContainerName={{ item.container_name }}
{% endif %}
{% if item.user is defined %}
User={{ item.user }}
{% endif %}
{% if item.hostname is defined %}
HostName={{ item.hostname }}
{% endif %}
{% if item.auto_update is defined %}
AutoUpdate={{ item.auto_update }}
{% endif %}
{% if item.read_only | default(true) %}
ReadOnly=true
{% endif %}
{% for capability in item.drop_capabilities | default([]) %}
DropCapability={{ capability }}
{% endfor %}
{% for capability in item.add_capabilities | default([]) %}
AddCapability={{ capability }}
{% endfor %}
{% if item.no_new_privileges | default(false) %}
NoNewPrivileges=true
{% endif %}
{% if item.network is defined %}
Network={{ item.network }}
{% endif %}
{% for port in item.ports | default([]) %}
PublishPort={{ port }}
{% endfor %}
{% for volume in item.volumes | default([]) %}
Volume={{ volume }}
{% endfor %}
{% for path in item.tmpfs | default([]) %}
Tmpfs={{ path }}
{% endfor %}
{% for ulimit in item.ulimits | default([]) %}
Ulimit={{ ulimit }}
{% endfor %}
{% if item.exec is defined %}
Exec={{ item.exec }}
{% endif %}
{% if item.stop_timeout is defined %}
StopTimeout={{ item.stop_timeout }}
{% endif %}
{% if item.health_cmd is defined %}
HealthCmd={{ item.health_cmd }}
{% endif %}
{% for setting in ['interval', 'timeout', 'retries'] if item['health_' ~ setting] is defined %}
Health{{ setting | capitalize }}={{ item['health_' ~ setting] }}
{% endfor %}
{% if item.environment | default({}) %}

{# Quadlet copies each value as written into ExecStart=, where systemd expands
   $ and reads $$ as a literal $, so each $ is doubled to reach the container. #}
{% for name, value in item.environment.items() %}
Environment={{ name }}={{ value | replace('$', '$$') }}
{% endfor %}
{% endif %}
{% if item.env_file | default(false) %}

EnvironmentFile={{ quadlet_dir }}/{{ item.name }}.env
{% endif %}
{% if item.environment_files | default([]) %}

{% for path in item.environment_files %}
EnvironmentFile={{ path }}
{% endfor %}
{% endif %}

[Service]
Restart={{ item.restart | default('always') }}

[Install]
WantedBy={{ item.wanted_by | default(['multi-user.target', 'default.target']) | join(' ') }}
