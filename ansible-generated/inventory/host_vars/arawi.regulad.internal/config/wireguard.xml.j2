<wireguard>
	<config>
		<enable>on</enable>
		<keep_conf>yes</keep_conf>
		<resolve_interval>300</resolve_interval>
		<resolve_interval_track>no</resolve_interval_track>
		<interface_group>all</interface_group>
		<hide_secrets>yes</hide_secrets>
		<hide_peers>yes</hide_peers>
	</config>
{# bailout's tunnels, declared in its host_vars; arawi's own private keys are
    in its secrets.sops.yml, and bailout's addresses come from OpenTofu state. #}
{% set bailout = hostvars['bailout'] %}
	<tunnels>
{% for tunnel in bailout.bailout_wireguard_tunnels.values() %}
		<item>
			<addresses>
				<row>
					<address>{{ tunnel.arawi_address }}</address>
					<mask>{{ tunnel.prefix_length }}</mask>
					<descr></descr>
				</row>
			</addresses>
			<name>{{ tunnel.arawi_tunnel }}</name>
			<enabled>yes</enabled>
			<descr>{{ tunnel.name }}</descr>
			<listenport>{{ tunnel.port }}</listenport>
			<privatekey>{{ arawi_wireguard_private_keys[tunnel.arawi_tunnel] }}</privatekey>
			<publickey>{{ tunnel.arawi_public_key }}</publickey>
			<mtu>1420</mtu>
		</item>
{% endfor %}
	</tunnels>
	<peers>
{% for tunnel in bailout.bailout_wireguard_tunnels.values() %}
		<item>
			<allowedips>
				<row>
					<address>{{ '::' if ':' in tunnel.arawi_address else '0.0.0.0' }}</address>
					<mask>0</mask>
					<descr></descr>
				</row>
			</allowedips>
			<enabled>yes</enabled>
			<tun>{{ tunnel.arawi_tunnel }}</tun>
			<descr>{{ tunnel.name }}</descr>
			<persistentkeepalive></persistentkeepalive>
			<publickey>{{ tunnel.bailout_public_key }}</publickey>
			<presharedkey></presharedkey>
			<endpoint>{{ bailout.public_ip if tunnel.outer == 'ipv4' else bailout.ipv6_address }}</endpoint>
			<port>{{ tunnel.port }}</port>
		</item>
{% endfor %}
	</peers>
</wireguard>
