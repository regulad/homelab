    {"name": "classless-static-route", "data": "100.64.0.0/10 - 10.23.2.171, 10.131.0.0/16 - 10.23.2.171, 0.0.0.0/0 - 10.23.0.254"},
    {"name": "v4-pcp-server", "csv-format": false, "data": "040A170001"},
  ],
} %}
