<unbound>
	<enable></enable>
	<dnssec></dnssec>
	<active_interface>all</active_interface>
	<outgoing_interface>all</outgoing_interface>
	<custom_options>{% filter b64encode %}
view:
    name: "guest"
    view-first: yes
    local-zone: "regulad.internal." always_nxdomain
    local-zone: "23.10.in-addr.arpa." always_nxdomain
    local-zone: "0.0.7.5.a.a.c.4.8.b.3.8.d.f.ip6.arpa." always_nxdomain

view:
    name: "local"
    view-first: yes
    #
    # regulad.xyz names are rewritten by the split-horizon RPZ below, which also
    # matches CNAME targets; view local-data matches only the name asked for.
    local-zone: "mynetworksettings.com." redirect
    local-data: "mynetworksettings.com. 60 IN CNAME cr1000b.regulad-verizon-livingston.internal."

server:
    # RPZ needs the respip module. This replaces the module-config pfSense
    # writes, "validator iterator" while DNSSEC is on; keep the two in step if
    # DNSSEC, DNS64 or the Python module changes.
    module-config: "respip validator iterator"
    do-not-query-localhost: no
    #
    private-domain: "regulad.internal."
    domain-insecure: "regulad.internal."
    local-zone: "regulad.internal." static
    #
    # AAAA and PTR records for named hosts' SLAAC addresses, beside the A
    # records, which /usr/local/bin/ndp-aaaa.php writes from the NDP table
    # every minute. A glob, so that Unbound starts before the file exists.
    include: "/var/unbound/ndp-aaaa*.conf"
    #
    private-domain: "regulad-verizon-livingston.internal."
    domain-insecure: "regulad-verizon-livingston.internal."
    #
    # Every "local" netblock carries the "lan" tag on exactly the same netblock:
    # each client matches one access-control entry, its most specific, and
    # entries inherit no tags or views from wider ones.
    define-tag: "lan"
    access-control-view: 10.23.0.0/16 local
    access-control-tag: 10.23.0.0/16 "lan"
    access-control-view: fd83:b84c:aa57:0001::/64 local
    access-control-tag: fd83:b84c:aa57:0001::/64 "lan"
    access-control-view: 100.64.0.0/10 local
    access-control-tag: 100.64.0.0/10 "lan"
    access-control-view: fd7a:115c:a1e0::/48 local
    access-control-tag: fd7a:115c:a1e0::/48 "lan"
    access-control-view: 10.131.80.239/24 local
    access-control-tag: 10.131.80.239/24 "lan"
    access-control-view: {{ arawi_ipv6_prefixes.oci_subnet }}::/64 local
    access-control-tag: {{ arawi_ipv6_prefixes.oci_subnet }}::/64 "lan"
    #
    access-control-view: 10.23.128.0/20 guest
    access-control-view: fd83:b84c:aa57:0008::/64 guest

# Internal answers for regulad.xyz names, for "lan" clients only. The zonefile is
# a copy on the /var RAM disk that unbound-rpz-restore.sh recreates at boot;
# Unbound will not start without it.
rpz:
    name: "split-horizon.rpz."
    zonefile: "/var/unbound/split-horizon.rpz"
    tags: "lan"

# RPZ rewrites only while resolving, never on a cache hit, so a public chain
# cached for a guest would reach "lan" clients. Nothing under regulad.xyz is
# cached; serve-expired cannot cover it either.
stub-zone:
    name: "regulad.xyz."
    stub-host: "art.ns.cloudflare.com."
    stub-host: "zainab.ns.cloudflare.com."
    stub-no-cache: yes

forward-zone:
    name: "regulad.internal."
    forward-addr: 127.0.0.1

server:
    serve-expired: yes
    serve-expired-ttl: 86400
    serve-expired-ttl-reset: yes
    serve-expired-reply-ttl: 30
    serve-expired-client-timeout: 1800
    ede: yes
    ede-serve-expired: yes
    prefetch: yes{% endfilter %}</custom_options>
