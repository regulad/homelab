<kea>
	<dnsreg></dnsreg>
	<earlydnsreg></earlydnsreg>
{# Kea's own global configuration, kept base64-encoded as pfSense stores it: a
   definition of PCP's server option (158, RFC 7291), which the LAN's option
   data uses. #}
{% set kea_config = {
  "option-def": [
    {"name": "v4-pcp-server", "code": 158, "space": "dhcp4", "type": "binary"},
  ],
} %}
	<custom_kea_config>{{ kea_config | to_json | b64encode }}</custom_kea_config>
</kea>
