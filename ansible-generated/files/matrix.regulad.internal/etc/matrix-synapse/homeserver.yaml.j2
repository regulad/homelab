server_name: regulad.xyz
public_baseurl: "https://matrix.regulad.xyz"
pid_file: "/var/run/matrix-synapse.pid"
listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    bind_addresses: ['::1', '127.0.0.1']
    resources:
      - names: [client, federation]
        compress: false
database:
  name: psycopg2
  args:
    user: synapse_user
    password: {{ synapse_secrets.database_password | to_json }}
    dbname: synapse
    host: localhost
    cp_min: 5
    cp_max: 10
log_config: "/etc/matrix-synapse/log.yaml"
media_store_path: "/var/lib/matrix-synapse/media"
signing_key_path: "/etc/matrix-synapse/homeserver.signing.key"
default_identity_server: "https://vector.im"  # provides email/phone <-> uid mapping  # privacy nightmare: does a lot more than just that
encryption_enabled_by_default_for_room_type: "off" # unfortunately, setting this to all breaks heisenbridge
trusted_key_servers:
  - server_name: "matrix.org"
suppress_key_server_warning: true
media_retention:
    local_media_lifetime: "14d"
    remote_media_lifetime: "1d"
redaction_retention_period: "7d"
forgotten_room_retention_period: "7d"
media_storage_providers:
  - module: s3_storage_provider.S3StorageProviderBackend
    store_local: true
    store_remote: true
    store_synchronous: true
    config:
      bucket: synapse-media
      region_name: default
      endpoint_url: https://s3.regulad.xyz
      access_key_id: {{ (rgw_keys.synapse | first).access_key | to_json }}
      secret_access_key: {{ (rgw_keys.synapse | first).secret_key | to_json }}
      # Ceph doesn't support AWS's new checksum behavior
      request_checksum_calculation: "when_required"
      response_checksum_validation: "when_required"
enable_registration: false  # should be false w/ ldap  # required for any type of user-led account creation in a client
recaptcha_public_key: {{ synapse_secrets.recaptcha_public_key | to_json }}
recaptcha_private_key: {{ synapse_secrets.recaptcha_private_key | to_json }}
enable_registration_captcha: true
registrations_require_3pid:
  - email
account_threepid_delegates:
    msisdn: "https://vector.im" # use pub server for phone number verification
disable_msisdn_registration: true
app_service_config_files:
  - "/etc/matrix-synapse/doublepuppet.yaml"
  - "/etc/matrix-synapse/heisenbridge.yaml"
  - "/opt/mautrix-meta/registration.yaml"
  - "/opt/mautrix-discord/registration.yaml"
  - "/opt/mautrix-telegram/registration.yaml"
  - "/opt/mautrix-slack/registration.yaml"
  - "/opt/mautrix-gmessages/registration.yaml"
  - "/opt/mautrix-messenger/registration.yaml"
  - "/opt/mautrix-whatsapp/registration.yaml"
enable_metrics: true
sentry:
    environment: "production"
    dsn: {{ synapse_secrets.sentry_dsn | to_json }}
report_stats: false
max_upload_size: "8M"
email:
  smtp_host: mail.regulad.xyz
  smtp_port: 587
  smtp_user: {{ synapse_smtp_user }}
  smtp_pass: {{ synapse_secrets.ldap_bind_password | to_json }}
  require_transport_security: true
  notif_from: "%(app)s <{{ synapse_smtp_user }}@regulad.xyz>"
  app_name: "matrix.regulad.xyz"
  enable_notifs: true
  notif_for_new_users: true
  validation_token_lifetime: 15m
  invite_client_location: https://app.element.io

  subjects:
    message_from_person_in_room: "[%(app)s] You have a message on %(app)s from %(person)s in the %(room)s room..."
    message_from_person: "[%(app)s] You have a message on %(app)s from %(person)s..."
    messages_from_person: "[%(app)s] You have messages on %(app)s from %(person)s..."
    messages_in_room: "[%(app)s] You have messages on %(app)s in the %(room)s room..."
    messages_in_room_and_others: "[%(app)s] You have messages on %(app)s in the %(room)s room and others..."
    messages_from_person_and_others: "[%(app)s] You have messages on %(app)s from %(person)s and others..."
    invite_from_person_to_room: "[%(app)s] %(person)s has invited you to join the %(room)s room on %(app)s..."
    invite_from_person: "[%(app)s] %(person)s has invited you to chat on %(app)s..."
    password_reset: "[%(server_name)s] Password reset"
    email_validation: "[%(server_name)s] Validate your email"
allow_guest_access: false
modules:
    - module: "ldap_auth_provider.LdapAuthProviderModule"
      config:
        enabled: true
        mode: "search"
        uri: "ldaps://freeipa.regulad-verizon-livingston.internal"
        base: "cn=users,cn=accounts,dc=home,dc=arpa"
        attributes:
           uid: "uid"
           mail: "mail"
           name: "displayname"
        filter: "(objectClass=posixAccount)"
        bind_dn: "uid=svc-synapse,cn=users,cn=accounts,dc=home,dc=arpa"
        bind_password: {{ synapse_secrets.ldap_bind_password | to_json }}
        tls_options:
           validate: true
    - module: shared_secret_authenticator.SharedSecretAuthProvider
      config:
          shared_secret: {{ synapse_secrets.shared_secret | to_json }}
          # By default, only login requests of type `com.devture.shared_secret_auth` are supported.
          # Below, we explicitly enable support for the old `m.login.password` login type,
          # which was used in v1 of matrix-synapse-shared-secret-auth and still widely supported by external software.
          # If you don't need such legacy support, consider setting this to `false` or omitting it entirely.
          m_login_password_support_enabled: true

          # By default, only login requests of type `com.devture.shared_secret_auth` are supported.
          #
          # Uncomment the line below to disable `com.devture.shared_secret_auth` support.
          # You will then need to:
          # - have `m_login_password_support_enabled: true` to enable the `m.login.password` login type
          # - authenticate using `m.login.password` requests, instead of ``com.devture.shared_secret_auth` requests
          # com_devture_shared_secret_auth_support_enabled: false
auto_join_rooms:
  - "#regulad:regulad.xyz"

# !!! BEGIN ELEMENT CALL CONFIG !!!
experimental_features:
  # MSC3266: Room summary API. Used for knocking over federation
  msc3266_enabled: true
  # MSC4222 needed for syncv2 state_after. This allow clients to
  # correctly track the state of the room.
  msc4222_enabled: true

# The maximum allowed duration by which sent events can be delayed, as
# per MSC4140.
max_event_delay_duration: 24h

rc_message:
  # This needs to match at least e2ee key sharing frequency plus a bit of headroom
  # Note key sharing events are bursty
  per_second: 0.5
  burst_count: 30

rc_delayed_event_mgmt:
  # This needs to match at least the heart-beat frequency plus a bit of headroom
  # Currently the heart-beat is every 5 seconds which translates into a rate of 0.2s
  per_second: 1
  burst_count: 20
