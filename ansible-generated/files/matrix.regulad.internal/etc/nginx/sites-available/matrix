server {
    # Listen on HTTPS ports
    listen 80;
    listen [::]:80;
    
    # Federation port
    #listen 8048 default_server;
    #listen [::]:8048 default_server;
    
    server_name matrix.regulad.xyz;

    # SSL configuration
    #ssl_certificate /etc/letsencrypt/live/matrix.regulad.xyz/fullchain.pem; # managed by Certbot
    #ssl_certificate_key /etc/letsencrypt/live/matrix.regulad.xyz/privkey.pem; # managed by Certbot
    
    # Recommended SSL settings
    #ssl_protocols TLSv1.2 TLSv1.3;
    #ssl_prefer_server_ciphers on;
    #ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    #ssl_session_timeout 1d;
    #ssl_session_cache shared:SSL:50m;
    #ssl_stapling on;
    #ssl_stapling_verify on;
    
    # HSTS (uncomment if you're sure)
    #add_header Strict-Transport-Security "max-age=63072000" always;

    # Matrix homeserver configuration
    location ~ ^(/_matrix|/_synapse/client|/health) {
        proxy_pass http://localhost:8008;
        #proxy_set_header X-Forwarded-For $remote_addr;
        #proxy_set_header X-Forwarded-Proto $scheme;
        #proxy_set_header Host $host:$server_port;

        # Increase upload size limit
        client_max_body_size 50M;

        # Enable chunked transfer encoding
        proxy_http_version 1.1;
    }

    # Root location block for other requests
    location / {
        return 404;
    }

}
