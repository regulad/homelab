[Unit]
Description=LiveKit WebRTC Server
Documentation=https://docs.livekit.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=livekit
Group=livekit

ExecStart=/usr/local/bin/livekit-server --config /etc/livekit/config.yaml

Restart=on-failure
RestartSec=5s

# Increase file descriptor limits (needed for many UDP connections)
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# Allow reading config
ReadWritePaths=/var/log/livekit
ReadOnlyPaths=/etc/livekit

# Network capabilities
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target