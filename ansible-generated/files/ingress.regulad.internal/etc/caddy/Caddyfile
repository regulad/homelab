{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	ech ingress.regulad.xyz

	# Coraza runs before any other handler in the sites that import it.
	order coraza_waf first

	# The sites that import cache store only what their upstream marks
	# cacheable: Souin treats a response without Cache-Control as public, for
	# its TTL, unless this default applies.
	cache {
		default_cache_control no-store
	}
	
	# WebSockets-over-h3 is broken in Chrome from Caddy, somehow
	servers {
		protocols h1 h2
	}
}

(hsts) {
	header {
		Strict-Transport-Security "max-age=31536000"
	}
}

(common) {
	tls {
		issuer acme {
			profile shortlived
			# The DNS challenge's propagation check follows CNAMEs, and the LAN's
			# resolver answers _acme-challenge.s3.regulad.xyz from the
			# *.s3.regulad.xyz wildcard and its split-horizon rewrite, so it never
			# sees the TXT record. Public resolvers see the record itself.
			resolvers [2606:4700:4700::1111]:53 [2606:4700:4700::1001]:53 1.1.1.1:53 1.0.0.1:53
		}
	}
}

(cache) {
	cache
}

# PHP2Shell and rawkey rules, for sites that front PHP.
(php2shell) {
	coraza_waf {
		directives `
			Include /etc/caddy/coraza/php2shell.conf
		`
	}
}

(mtls) {
	tls {
		client_auth {
			mode require_and_verify
			trusted_ca_cert_file /etc/ssl/certs/ca-certificates.crt
		}
	}
}

# Each site, in a file of its own named after its first address. The path is
# absolute, so validating a copy of this file elsewhere reads them too.
import /etc/caddy/config.d/*.caddyfile
