{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	ech ingress.regulad.xyz

	# Coraza runs before any other handler in the sites that import it.
	order coraza_waf first

	# The sites that import cache store only what their upstream marks
	# cacheable: Souin treats a response without Cache-Control as public, for
	# its TTL, unless this default applies.
	cache {
		default_cache_control no-store
		# Souin gives every request it handles, cached or not, a deadline of its
		# backend timeout, 10s by default, and cuts the response there: streams,
		# uploads and long polls alike. It has no setting to turn that off, and 0
		# means the default, so a year stands in for none.
		timeout {
			backend 8760h
		}
	}
	
	# WebSockets-over-h3 is broken in Chrome from Caddy, somehow
	servers {
		protocols h1 h2
	}
}

(hsts) {
	header {
		Strict-Transport-Security "max-age=31536000"
	}
}

(common) {
	tls {
		issuer acme {
			profile shortlived
			# The DNS challenge's propagation check follows CNAMEs, and the LAN's
			# resolver answers _acme-challenge.s3.regulad.xyz from the
			# *.s3.regulad.xyz wildcard and its split-horizon rewrite, so it never
			# sees the TXT record. Public resolvers see the record itself.
			resolvers [2606:4700:4700::1111]:53 [2606:4700:4700::1001]:53 1.1.1.1:53 1.0.0.1:53
		}
	}
}

(cache) {
	cache
}

# PHP2Shell and rawkey rules, for sites that front PHP.
(php2shell) {
	coraza_waf {
		directives `
			Include /etc/caddy/coraza/php2shell.conf
		`
	}
}

# Client certificates from the homelab's three issuing CAs: arawi's internal-ca
# and regulad.internal, and wako's FreeIPA CA (freeipa-regulad.internal). The
# system bundle would admit one from any public CA. Their anchors are the ones
# the ca_trust role installs on Ubuntu.
(mtls) {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /usr/local/share/ca-certificates/internal-ca.crt
				pem_file /usr/local/share/ca-certificates/regulad.internal.crt
				pem_file /usr/local/share/ca-certificates/freeipa-regulad.internal.crt
			}
		}
	}
}

# The same CAs' client certificates, asked for but not required: a client may
# present none, and one it presents must verify. The site decides what a
# request without one may reach, from {http.request.tls.client.subject}, which
# is empty then.
(mtls_optional) {
	tls {
		client_auth {
			mode verify_if_given
			trust_pool file {
				pem_file /usr/local/share/ca-certificates/internal-ca.crt
				pem_file /usr/local/share/ca-certificates/regulad.internal.crt
				pem_file /usr/local/share/ca-certificates/freeipa-regulad.internal.crt
			}
		}
	}
}

# A matcher for the LAN's addresses, its IPv4 range and its ULA prefix, which
# a named matcher imports: as remote_ip, or within not. Its GUA prefix rotates,
# so it is left out.
(lan_remote_ip) {
	remote_ip 10.23.0.0/20 fd83:b84c:aa57:1::/64
}

# One of Nexus's Docker repositories, named by the import's argument, at the
# root of a host of its own: Docker's API always starts at <host>/v2/, so it
# cannot take the repository's path on repo.regulad.xyz. As Sonatype's
# reverse-proxy guide does it, /v2/ is rewritten to the repository's own
# /repository/<name>/v2/ on Nexus's one port, the token realm, <host>/v2/token,
# with it.
(nexus_docker) {
	# Souin holds each GET until its upstream finishes, so image layers go
	# straight to Nexus. cache runs before rewrite, so the regex sees the
	# client's /v2/ path. The global cache block's other settings still apply.
	cache {
		regex {
			exclude ^/v2/.+/blobs/
		}
	}

	@docker path /v2 /v2/*
	rewrite @docker /repository/{args[0]}{uri}

	# The LAN's hosts pull with no credentials of their own: a Docker API
	# request from the LAN that carries none reaches Nexus with X-Homelab-Peer
	# naming svc-homelab, whom Nexus's Rut Auth realm takes as its user. A
	# request that authenticates itself, with a password or Docker's bearer
	# token, keeps its own user, and Nexus's other paths, its UI among them,
	# are left alone. The path is the one rewritten above, as rewrite runs
	# before route. Only the LAN's IPv4 and ULA ranges match, since its GUA
	# prefix rotates. Nexus takes whichever user the header names, so any copy
	# a client sends is dropped first.
	@local_peer {
		path /repository/{args[0]}/v2 /repository/{args[0]}/v2/*
		import lan_remote_ip
		header !Authorization
	}
	route {
		request_header -X-Homelab-Peer
		request_header @local_peer X-Homelab-Peer svc-homelab
	}

	# IPv4 only: Nexus's firewall admits ingress's reserved IPv4 address alone,
	# as ingress's GUA rotates with the delegated prefix.
	reverse_proxy {
		dynamic a nexus.regulad.internal 8081 {
			versions ipv4
		}
	}
}

# Each site, in a file of its own named after its first address. The path is
# absolute, so validating a copy of this file elsewhere reads them too.
import /etc/caddy/config.d/*.caddyfile
