{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	ech ingress.regulad.xyz

	# Coraza runs before any other handler in the sites that import it.
	order coraza_waf first
	
	# WebSockets-over-h3 is broken in Chrome from Caddy, somehow
	servers {
		protocols h1 h2
	}
}

(hsts) {
	header {
		Strict-Transport-Security "max-age=31536000"
	}
}

(common) {
	tls {
		issuer acme {
			profile shortlived
		}
	}
}

(cache) {
	cache
}

# PHP2Shell and rawkey rules, for sites that front PHP.
(php2shell) {
	coraza_waf {
		directives `
			Include /etc/caddy/coraza/php2shell.conf
		`
	}
}

(mtls) {
	tls {
		client_auth {
			mode require_and_verify
			trusted_ca_cert_file /etc/ssl/certs/ca-certificates.crt
		}
	}
}

http://kodi.regulad.xyz, https://kodi.regulad.xyz {
	# legacy
	
	import common
	import hsts

	root * /srv/kodi
	file_server	
}

http://ios.regulad.xyz, https://ios.regulad.xyz {
	# legacy	

	import common
	import hsts

	encode zstd gzip

	@onDisk {
		file {
			root /srv/cydia
		}
	}

	handle @onDisk {
		root * /srv/cydia
		file_server
	}

	handle {
		rewrite * /repository/ios{uri}

		reverse_proxy https://repo.regulad.xyz {
			header_up Host repo.regulad.xyz
		}
	}

}

kasm.regulad.xyz {
	import common
	import hsts

	reverse_proxy https://vkasm.regulad.internal:443 {
		transport http {
			tls_insecure_skip_verify
			read_timeout 0
			write_timeout 0
		}
		header_up Host {host}
		flush_interval -1
		header_up X-Forwarded-Port "443"
	}
}

pterodactyl.regulad.xyz {
	import hsts
	import common

	@needs_cert {
		not path /api/remote/*
		expression {tls_client_subject} == ""
	}
#	respond @needs_cert "Client certificate required" 495	

	reverse_proxy pterodactyl.regulad.internal:80 {
	}
}

