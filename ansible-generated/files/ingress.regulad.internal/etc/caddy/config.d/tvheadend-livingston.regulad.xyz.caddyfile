tvheadend-livingston.regulad.xyz {
	import hsts
	import common
	# No cache: Souin holds each response until its upstream finishes, and a
	# live stream never does.

	# IPv4 only: the guest's firewall admits ingress's reserved IPv4 address
	# alone, as ingress's GUA rotates with the delegated prefix.
	reverse_proxy {
		dynamic a tvheadend.regulad.internal 9981 {
			versions ipv4
		}
	}
}
