nextcloud.regulad.xyz {
	import hsts
	import common
	# Souin holds each GET until its upstream finishes, and drops a range
	# request's Range before asking upstream, so a 2-byte probe of a video waits
	# for the whole file. Files, through WebDAV, direct links or public shares,
	# come from remote.php and public.php, so those go straight to Nextcloud.
	# The global cache block's other settings still apply here.
	cache {
		regex {
			exclude ^/(remote|public)[.]php/
		}
	}

	@wellknown_dav path /.well-known/carddav /.well-known/caldav
	redir @wellknown_dav /remote.php/dav/ 301

	@wellknown_webfinger path /.well-known/webfinger
	redir @wellknown_webfinger /index.php/.well-known/webfinger

	handle /.well-known/* {
		respond 404
	}

	# IPv4 only: Nextcloud is published on IPv4 alone and trusts its proxies by
	# their IPv4 addresses, since ingress's GUA rotates.
	reverse_proxy {
		dynamic a aboriginal.regulad.internal 12378 {
			versions ipv4
		}
	}
}
