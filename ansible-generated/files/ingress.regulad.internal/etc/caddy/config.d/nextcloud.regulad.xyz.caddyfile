nextcloud.regulad.xyz {
	import hsts
	import common
	import php2shell
	import cache

	@wellknown_dav path /.well-known/carddav /.well-known/caldav
	redir @wellknown_dav /remote.php/dav/ 301

	@wellknown_webfinger path /.well-known/webfinger
	redir @wellknown_webfinger /index.php/.well-known/webfinger

	handle /.well-known/* {
		respond 404
	}

	# IPv4 only: Nextcloud is published on IPv4 alone and trusts its proxies by
	# their IPv4 addresses, since ingress's GUA rotates.
	reverse_proxy {
		dynamic a aboriginal.regulad.internal 12378 {
			versions ipv4
		}
	}
}
