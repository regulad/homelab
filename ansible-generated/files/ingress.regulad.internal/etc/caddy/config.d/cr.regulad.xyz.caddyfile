# The Docker API, which clients expect at the root, from the cr repository's
# path on Nexus's one port, as Sonatype's reverse-proxy guide does it. Nexus's
# token realm, <host>/v2/token, comes through the same rewrite.
cr.regulad.xyz {
	import hsts
	import common
	import cache

	@docker path /v2 /v2/*
	rewrite @docker /repository/cr{uri}

	reverse_proxy nexus.regulad.internal:8081 {
	}
}
