repo.regulad.xyz {
	import hsts
	import common
	# Souin holds each GET until its upstream finishes, so everything under
	# /repository/, every component Nexus serves, goes straight to it. The
	# global cache block's other settings still apply here.
	cache {
		regex {
			exclude ^/repository/
		}
	}

	# IPv4 only: Nexus's firewall admits ingress's reserved IPv4 address alone,
	# as ingress's GUA rotates with the delegated prefix. Nexus's Rut Auth realm
	# takes whichever user X-Homelab-Peer names, which only cr.regulad.xyz sets,
	# so a client's copy never reaches it.
	reverse_proxy {
		dynamic a nexus.regulad.internal 8081 {
			versions ipv4
		}
		header_up -X-Homelab-Peer
	}
}
