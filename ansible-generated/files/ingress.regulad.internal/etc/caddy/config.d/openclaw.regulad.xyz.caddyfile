openclaw.regulad.xyz {
	import hsts
	import mtls
	import common	
	import cache
	
	# IPv4 only: the guest's firewall admits ingress's reserved IPv4 address
	# alone, as ingress's GUA rotates with the delegated prefix.
	reverse_proxy {
		dynamic a openclaw.regulad.internal 18789 {
			versions ipv4
		}
	}
}
