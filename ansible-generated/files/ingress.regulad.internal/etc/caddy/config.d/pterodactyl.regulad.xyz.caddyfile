pterodactyl.regulad.xyz {
	import hsts
	import common
	import cache

	@needs_cert {
		not path /api/remote/*
		expression {tls_client_subject} == ""
	}
#	respond @needs_cert "Client certificate required" 495	

	# IPv4 only: the guest's firewall admits ingress's reserved IPv4 address
	# alone, as ingress's GUA rotates with the delegated prefix.
	reverse_proxy {
		dynamic a pterodactyl.regulad.internal 80 {
			versions ipv4
		}
	}
}
