# Using verify_if_given breaks Jellyfin Media Player
jf.regulad.xyz {
	import hsts
	import common
	import cache

	# IPv4 only: Jellyfin does not count ingress's IPv6 address as on its LAN,
	# so it rejects the proxy headers of connections from it.
	reverse_proxy {
		dynamic a aboriginal.regulad.internal 8096 {
			versions ipv4
		}
	}
}
