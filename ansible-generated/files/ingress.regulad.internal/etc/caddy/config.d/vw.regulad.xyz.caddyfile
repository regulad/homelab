vw.regulad.xyz {
	import hsts
	import common
	# No cache: Souin holds each response until its upstream finishes, so
	# attachments and Sends would wait in Caddy's memory whole.

	# IPv4 only: the guest's firewall admits ingress's reserved IPv4 address
	# alone, as ingress's GUA rotates with the delegated prefix.
	reverse_proxy {
		dynamic a vaultwarden.regulad.internal 8000 {
			versions ipv4
		}
	}
}
