http://ios.regulad.xyz, https://ios.regulad.xyz {
	# legacy	

	import common
	import cache
	import hsts

	encode zstd gzip

	@onDisk {
		file {
			root /srv/cydia
		}
	}

	handle @onDisk {
		root * /srv/cydia
		file_server
	}

	handle {
		rewrite * /repository/ios{uri}

		# IPv4 only, as Nexus's firewall admits ingress's reserved IPv4 address
		# alone; and never a client's X-Homelab-Peer, whose user Nexus's Rut
		# Auth realm would take.
		reverse_proxy {
			dynamic a nexus.regulad.internal 8081 {
				versions ipv4
			}
			header_up Host repo.regulad.xyz
			header_up -X-Homelab-Peer
		}
	}

}
