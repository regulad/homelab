matrix.regulad.xyz {
	import hsts
	import common
	# No cache: media requests carry Authorization, so Souin would store none of
	# them, and would hold each download in Caddy's memory until it ended.

	# IPv4 only: the guest's firewall admits ingress's reserved IPv4 address
	# alone, as ingress's GUA rotates with the delegated prefix.
	reverse_proxy {
		dynamic a matrix.regulad.internal 80 {
			versions ipv4
		}
	}
}
