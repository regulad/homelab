[Unit]
Description=Caddy
After=network-online.target

[Service]
EnvironmentFile=/etc/caddy/cloudflare.env
# Built by caddy-build.service, which restarts this unit on a new build.
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile
ExecReload=/usr/local/bin/caddy reload --force --config /etc/caddy/Caddyfile
TimeoutStopSec=5s
Restart=on-failure

[Install]
WantedBy=multi-user.target
