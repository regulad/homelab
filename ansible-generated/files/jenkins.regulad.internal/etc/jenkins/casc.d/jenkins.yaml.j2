# Managed by Ansible (host_files), from Jenkins's own export on 2026-11-18.
# Jenkins's configuration as code: the Configuration as Code plugin applies it
# at each start, from CASC_JENKINS_CONFIG. ${name} is the content of
# /run/secrets/name, a file host_files writes from SOPS; settings left out keep
# Jenkins's defaults.
jenkins:
  numExecutors: 0
  mode: EXCLUSIVE
  slaveAgentPort: 50000
  quietPeriod: 5
  scmCheckoutRetryCount: 0
  markupFormatter: "plainText"
  crumbIssuer: "standard"
  disableRememberMe: false
  projectNamingStrategy: "standard"
  disabledAdministrativeMonitors:
    - "jenkins.monitor.JavaVersionRecommendationAdminMonitor-21-2027-09-30-WARNING"
    - "hudson.util.DoubleLaunchChecker"
    - "jenkins.diagnostics.ControllerExecutorsAgents"
    - "hudson.diagnosis.ReverseProxySetupMonitor"
  # wako's directory, which admits jenkinsusers' members alone; every one of
  # them administers Jenkins.
  securityRealm:
    ldap:
      configurations:
        - server: "ldaps://wako.regulad.internal"
          rootDN: "dc=regulad,dc=internal"
          inhibitInferRootDN: false
          userSearchBase: "cn=users,cn=accounts"
          userSearch: "(&(uid={0})(memberOf=cn=jenkinsusers,cn=groups,cn=accounts,dc=regulad,dc=internal))"
          groupSearchBase: "cn=groups,cn=accounts"
          groupSearchFilter: "(& (cn={0}) (| (objectclass=groupOfNames) (objectclass=groupOfUniqueNames) (objectclass=posixGroup)))"
          groupMembershipStrategy:
            fromUserRecord:
              attributeName: "memberOf"
          managerDN: "uid=svc-jenkins,cn=users,cn=accounts,dc=regulad,dc=internal"
          managerPasswordSecret: "${ldap_manager_password}"
          displayNameAttributeName: "displayname"
          mailAddressAttributeName: "mail"
          ignoreIfUnavailable: false
      disableMailAddressResolver: false
      disableRolePrefixing: true
      userIdStrategy: "caseInsensitive"
      groupIdStrategy: "caseInsensitive"
  authorizationStrategy:
    loggedInUsersCanDoAnything:
      allowAnonymousRead: false
  # The agents: a container for each build, under rootless Podman as
  # jenkins-agents, whose API socket the controller mounts (services.yml). Each
  # has a network namespace of its own from pasta, with this container's
  # addresses in both families; the Docker API's default, Podman's bridge,
  # would give it IPv4 alone. Each reaches the controller on this container's
  # port 8080 through Podman's host.containers.internal, over WebSocket, so the
  # inbound agent port is never used. ^${...} passes the docker-plugin's own
  # variables through Configuration as Code unexpanded.
  clouds:
    - docker:
        name: "podman"
        containerCap: 2
        dockerApi:
          dockerHost:
            uri: "unix:///run/podman-agents/podman.sock"
        templates:
          - name: "inbound-agent"
            labelString: "podman"
            mode: EXCLUSIVE
            instanceCapStr: "2"
            remoteFs: "/home/jenkins/agent"
            pullStrategy: PULL_LATEST
            pullTimeout: 300
            removeVolumes: true
            dockerTemplateBase:
              image: "docker.io/jenkins/inbound-agent:{{ jenkins_agent_image_tag }}"
              network: "pasta"
              # The image's entry point passes JENKINS_AGENT_WORKDIR to the agent
              # as its work directory, which otherwise has none.
              environmentsString: "JENKINS_WEB_SOCKET=true\nJENKINS_AGENT_WORKDIR=/home/jenkins/agent"
            connector:
              jnlp:
                jenkinsUrl: "http://host.containers.internal:8080/"
                entryPointArgumentsString: "-url\n^${JENKINS_URL}\n-secret\n^${JNLP_SECRET}\n-name\n^${NODE_NAME}"

# A credential here, in the system store, is every job's. regulad/jobs's seed
# rewrites each folder it defines at every run, so the credentials its jobs use
# live here rather than in their folders; only the regulad folder, which this
# file defines, keeps credentials of its own, below.
credentials:
  system:
    domainCredentials:
      - credentials:
          # The secret GitHub signs the App's webhook deliveries with.
          - string:
              id: "github-webhook-secret"
              scope: SYSTEM
              description: "The GitHub App's webhook secret"
              secret: "${github_webhook_secret}"
          # The age key that opens regulad/jobs's SOPS files, bound as
          # SOPS_AGE_KEY.
          - string:
              id: "jobs-sops-age-key"
              scope: GLOBAL
              description: "The age key that opens regulad/jobs's SOPS files"
              secret: "${jobs_sops_age_key}"
          # regubot's token for its fork of winget-pkgs, which regulad/jobs's
          # winget jobs submit with through Komac.
          - string:
              id: "winget-token"
              scope: GLOBAL
              description: "regubot's token for its fork of winget-pkgs"
              secret: "${winget_token}"
          # regulad-jenkins for the items outside the regulad folder, whose own
          # takes precedence inside it: a credential of Jenkins's GitHub App
          # (host_vars main.yml, github-app.sops.env) that reads regulad/jobs
          # alone, with its contents read-only, enough to read GitHub's public
          # data, such as z4yx/pam_rssh's releases, without its lower anonymous
          # rate limit. Each use mints an installation token of at most an hour.
          - gitHubApp:
              scope: GLOBAL
              id: "regulad-jenkins"
              description: "regulad-jenkins, Jenkins's GitHub App, reading regulad/jobs alone"
              appID: "{{ jenkins_github_app_id }}"
              privateKey: "${github_app_private_key}"
              repositoryAccessStrategy:
                specificRepositories:
                  owner: "regulad"
                  repositories:
                    - "jobs"
              defaultPermissionsStrategy: CONTENTS_READ
          # svc-pam-rssh-ci, the Nexus user z4yx/pam_rssh uploads pam_rssh's
          # packages as (group_vars nexus_servers.yml).
          - usernamePassword:
              scope: GLOBAL
              id: "svc-pam-rssh-ci"
              description: "svc-pam-rssh-ci, which uploads pam_rssh's packages to Nexus"
              username: "svc-pam-rssh-ci"
              usernameSecret: false
              password: "${nexus_svc_pam_rssh_ci_password}"

unclassified:
  location:
    adminAddress: "regulad@regulad.xyz"
    url: "https://ci.regulad.xyz/"
  gitHubConfiguration:
    apiRateLimitChecker: ThrottleForNormalize
  gitHubPluginConfig:
    hookUrl: "https://ci.regulad.xyz/github-webhook/"
    hookSecretConfigs:
      - credentialsId: "github-webhook-secret"

# Maven, for builds that name it (tools { maven 'maven' }): the agents' image
# has a JDK but no Maven, so Jenkins downloads this release onto each agent
# whose build asks for it, from the list Jenkins's update site serves.
tool:
  maven:
    installations:
      - name: "maven"
        properties:
          - installSource:
              installers:
                - maven:
                    id: "3.9.16"

# Job DSL runs its scripts without script security's approval, which would
# otherwise be needed again for each edit. Its only scripts are this file's and
# regulad/jobs's, which that repository's own Jenkinsfile, its seed, applies
# when the regulad folder builds its main branch, at each push to it; only
# regulad writes to either.
security:
  globalJobDslSecurityConfiguration:
    useScriptSecurity: false

# Items, as Job DSL scripts. The regulad folder builds every Jenkinsfile in
# regulad's repositories, as it did before this file, regulad/jobs's seed among
# them, as regulad/jobs/main; that seed defines the other items, folders
# included.
#
# The regulad folder holds its own regulad-jenkins, a credential of Jenkins's
# GitHub App for every repository of regulad's, with every permission the App
# has. Configuration as Code puts each ${name} into a script before Job DSL
# runs; the App's private key, which runs over several lines, goes in a '''
# string, and Job DSL takes it only as a Secret.
jobs:
  - script: |
      organizationFolder('regulad') {
        // Every repository of regulad's, with every permission the App has.
        properties {
          folderCredentialsProperty {
            domainCredentials {
              domainCredentials {
                domain {
                  name('')
                  description('')
                }
                credentials {
                  gitHubAppCredentials {
                    scope('GLOBAL')
                    id('regulad-jenkins')
                    description("regulad-jenkins, Jenkins's GitHub App, for all of regulad's repositories")
                    appID('{{ jenkins_github_app_id }}')
                    privateKey(hudson.util.Secret.fromString('''${github_app_private_key}'''))
                    repositoryAccessStrategy {
                      specificRepositories {
                        owner('regulad')
                        repositories([])
                      }
                    }
                    defaultPermissionsStrategy('INHERIT_ALL')
                  }
                }
              }
            }
          }
        }
        organizations {
          github {
            repoOwner('regulad')
            apiUri('https://api.github.com')
            credentialsId('regulad-jenkins')
            enableAvatar(true)
            traits {
              gitHubBranchDiscovery {
                strategyId(1)
              }
              gitHubPullRequestDiscovery {
                strategyId(2)
              }
              gitHubForkDiscovery {
                strategyId(2)
                trust {
                  gitHubTrustPermissions()
                }
              }
            }
          }
        }
        projectFactories {
          workflowMultiBranchProjectFactory {
            scriptPath('Jenkinsfile')
          }
        }
        // Children rescan daily, as the live folder had it. Job DSL cannot describe
        // that property's list of triggers, so it is written as Jenkins's own XML.
        configure { folder ->
          // No folder-level health metric, as the live folder had none.
          (folder / 'healthMetrics').value = []
          folder / 'properties' << 'jenkins.branch.OrganizationChildTriggersProperty' {
            templates {
              'com.cloudbees.hudson.plugins.folder.computed.PeriodicFolderTrigger' {
                spec('H H/4 * * *')
                interval('86400000')
              }
            }
          }
        }
        triggers {
          periodicFolderTrigger {
            interval('1d')
          }
        }
        orphanedItemStrategy {
          discardOldItems {
          }
        }
      }
