# The nas archive's nextcloud under CephFS's: writes land in CephFS, and files
# only in the archive are read from it. A mount unit, so the units that need
# it start only once fuse-overlayfs has mounted it.
[Unit]
Description=/mnt/nextcloud: the nas archive's nextcloud under CephFS's (fuse-overlayfs)
DefaultDependencies=no
Requires=mnt-nas.mount mnt-cephfs.mount
After=mnt-nas.mount mnt-cephfs.mount
Conflicts=umount.target
Before=umount.target

[Mount]
What=fuse-overlayfs
Where=/mnt/nextcloud
Type=fuse.fuse-overlayfs
Options=lowerdir=/mnt/nas/nextcloud,upperdir=/mnt/cephfs/application/nextcloud,workdir=/mnt/cephfs/application/.nextcloud-work,allow_other

[Install]
WantedBy=multi-user.target
