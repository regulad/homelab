# The nas archive, the latest snapshot that mnt-restic.service mounts: the
# overlays' lower layer, mounted when they need it.
[Unit]
Description=/mnt/nas: the restic nas archive, read-only
DefaultDependencies=no
Requires=mnt-restic.service
After=mnt-restic.service
Conflicts=umount.target
Before=umount.target

[Mount]
What=/mnt/restic/snapshots/latest/mnt/nas
Where=/mnt/nas
Type=none
Options=bind,ro
# Detached even while an overlay's fuse-overlayfs still holds its lower layer
# open, so a stop of mnt-restic.service never leaves /mnt/nas bound to the
# restic mount it killed. Read-only, so nothing is lost; the overlays above it
# unmount normally.
LazyUnmount=yes
