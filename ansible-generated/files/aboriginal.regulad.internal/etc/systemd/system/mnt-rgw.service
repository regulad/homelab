[Unit]
Description=RGW rclone FUSE mount
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/bin/mkdir -p /mnt/rgw
ExecStart=/usr/bin/rclone mount rgw: /mnt/rgw \
  --allow-other \
  --log-systemd
ExecStop=/bin/fusermount -u /mnt/rgw
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
