[Unit]
Description=llama.cpp server
After=network-online.target remote-fs.target
Wants=network-online.target
Requires=remote-fs.target

[Service]
ExecStart=/opt/llama.cpp/build/bin/llama-server \
    --host 0.0.0.0 \
    --port 9292 \
    -m /mnt/cephfs/application/llama-models/qwen3.8-27b/Qwen3.8-27B-UD-IQ2_S.gguf \
    -np 1 \
    -ub 256 \
    --mmproj /mnt/cephfs/application/llama-models/qwen3.8-27b/mmproj-F16.gguf \
    --alias qwen3.8-27b \
    --ctx-size 262144 \
    -ngl all \
    -fa on \
    --cache-type-k q4_0 \
    --cache-type-v q4_0 \
    --image-min-tokens 1024 \
    --top-k 20 \
    --top-p 0.95 \
    --min-p 0.0 \
    --temp 1.0 \
    --api-key-file /etc/llama-server/api-key \
    --device ROCm0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
