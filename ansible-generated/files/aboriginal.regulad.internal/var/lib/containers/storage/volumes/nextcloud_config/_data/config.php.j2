{#-
  Nextcloud's config.php, which the nextcloud role writes into the
  nextcloud_config volume, in the form Nextcloud writes it itself (PHP's
  var_export, trailing spaces included), so a file Nextcloud rewrites with the
  same values stays the same byte for byte.
  version and maintenance are Nextcloud's own: the role reads them from the live
  configuration at each run. Values with a single source elsewhere come from it.
-#}
{% macro php(value) -%}
'{{ value | string | replace('\\', '\\\\') | replace("'", "\\'") }}'
{%- endmacro -%}
