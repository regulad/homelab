#!/usr/bin/env bash
# Starts restic mount in the background, writes its PID, then polls until the
# FUSE filesystem is actually mounted before exiting (Type=forking semantics).
set -euo pipefail

MOUNT_POINT=/mnt/restic
PID_FILE=/run/restic-mount.pid
TIMEOUT_SECS=120

/usr/bin/restic mount \
    --allow-other \
    --no-lock \
    --path /mnt/nas \
    --tag nas \
    --verbose \
    "$MOUNT_POINT" &
RESTIC_PID=$!
echo "$RESTIC_PID" >"$PID_FILE"

echo "restic-mount-helper: waiting for FUSE mount at $MOUNT_POINT (pid $RESTIC_PID)..." >&2
for ((i = 0; i < TIMEOUT_SECS * 2; i++)); do
    if mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
        echo "restic-mount-helper: mount ready." >&2
        exit 0
    fi
    if ! kill -0 "$RESTIC_PID" 2>/dev/null; then
        echo "restic-mount-helper: restic process died unexpectedly." >&2
        exit 1
    fi
    sleep 0.5
done

echo "restic-mount-helper: timed out after ${TIMEOUT_SECS}s." >&2
kill "$RESTIC_PID" 2>/dev/null || true
exit 1
