# Home Assistant and its Matter server, on the host's network. Run by
# podman-compose@homeassistant.service. Home Assistant's config, its own state,
# is on the SSD; the Matter server's fabric is in a volume.
# No pod: podman-compose's pods have no infra container, and podman-auto-update
# fails on a container in one, the whole run with it.
x-podman:
  in_pod: false

services:
  homeassistant:
    # homeassistant_release, which maintenance.yml's homeassistant-upgrade moves.
    image: docker.io/homeassistant/home-assistant:{{ homeassistant_release }}
    container_name: homeassistant
    labels:
      io.containers.autoupdate: registry
    # It installs its integrations' Python packages into the image's own
    # environment as it loads them, so it writes its root.
    read_only: false
    network_mode: host
    # Bluetooth's raw sockets and the USB devices behind its integrations.
    privileged: true
    volumes:
      - config:/config
      - /etc/localtime:/etc/localtime:ro
      # Bluetooth: USB adapters plugged in after the start, and BlueZ.
      - /dev/bus/usb:/dev/bus/usb
      - /run/dbus:/run/dbus:ro
    devices:
      # ZHA's Zigbee stick.
      - /dev/ttyUSB0:/dev/ttyUSB0
    restart: always
    # The image's s6 gives Home Assistant up to 4 minutes to stop
    # (S6_SERVICES_GRACETIME); Podman's default would kill it after 10 s,
    # before it has finished shutting down and closed its database.
    stop_grace_period: 4m
  matter-server:
    # matterjs-server, upstream's successor to the archived python-matter-server,
    # whose fabric it migrated at its first start.
    image: ghcr.io/matter-js/matterjs-server:1
    container_name: matter-server
    labels:
      io.containers.autoupdate: registry
    read_only: true
    network_mode: host
    # Its ping, which the API's ping_node runs, carries the file capability
    # cap_net_raw, so it cannot run where Podman withholds that, as it does
    # by default.
    cap_add:
      - NET_RAW
    tmpfs:
      - /tmp
    volumes:
      # U: the image runs as 1000:1000, and the Python server, whose files
      # these were, ran as root.
      - matter_data:/data:U
    restart: always
    environment:
      TZ: America/New_York
      # Its API takes no login and controls every device, and Home Assistant,
      # its one client, connects over loopback.
      LISTEN_ADDRESS: "::1,127.0.0.1"
      # eth0 and wlan0 are on the same LAN; eth0 carries the default routes.
      PRIMARY_INTERFACE: eth0
volumes:
  config:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: {{ homeassistant_config_dir }}
  matter_data:
