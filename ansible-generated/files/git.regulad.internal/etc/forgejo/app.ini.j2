; Forgejo's configuration, rendered by Ansible: the git VM's app.ini with its
; secrets from SOPS, paths under the rootless image's /var/lib/gitea, and the
; built-in SSH server.
APP_NAME = regulad's git
APP_SLOGAN = https://regulad.xyz
RUN_USER = git
WORK_PATH = /var/lib/gitea
RUN_MODE = prod

[federation]
ENABLED = true

[database]
DB_TYPE = sqlite3
HOST = 127.0.0.1:3306
NAME = forgejo
USER = forgejo
PASSWD = 
SCHEMA = 
SSL_MODE = disable
PATH = /var/lib/gitea/data/forgejo.db
LOG_SQL = false

[repository]
ROOT = /var/lib/gitea/data/forgejo-repositories

[repository.upload]
FILE_MAX_SIZE = 4095
MAX_FILES = 20

[server]
SSH_DOMAIN = git-ssh.regulad.xyz
DOMAIN = git.regulad.xyz
HTTP_PORT = 3000
ROOT_URL = https://git.regulad.xyz/
APP_DATA_PATH = /var/lib/gitea/data
DISABLE_SSH = false
SSH_PORT = 22
; Forgejo's built-in SSH server, which the tunnel reaches on 2222; clone
; URLs keep the forgejo user and port 22 the tunnel presents.
START_SSH_SERVER = true
SSH_LISTEN_PORT = 2222
SSH_USER = forgejo
BUILTIN_SSH_SERVER_USER = forgejo
; The VM's sshd host keys, so clients' known_hosts still match.
SSH_SERVER_HOST_KEYS = ssh/ssh_host_ed25519_key, ssh/ssh_host_ecdsa_key, ssh/ssh_host_rsa_key
LFS_START_SERVER = true
LFS_JWT_SECRET = {{ forgejo_secrets.server_lfs_jwt_secret }}
OFFLINE_MODE = false

[lfs]
PATH = /var/lib/gitea/data/lfs

[mailer]
ENABLED = true
SMTP_ADDR = mail.regulad.xyz
SMTP_PORT = 465
FROM = svc-git@regulad.xyz
USER = svc-git
PASSWD = {{ forgejo_secrets.mailer_passwd }}

[service]
REGISTER_EMAIL_CONFIRM = true
ENABLE_NOTIFY_MAIL = true
DISABLE_REGISTRATION = false
ALLOW_ONLY_EXTERNAL_REGISTRATION = false
ENABLE_CAPTCHA = true
REQUIRE_SIGNIN_VIEW = false
DEFAULT_KEEP_EMAIL_PRIVATE = false
DEFAULT_ALLOW_CREATE_ORGANIZATION = true
DEFAULT_ENABLE_TIMETRACKING = true

[openid]
ENABLE_OPENID_SIGNIN = true
ENABLE_OPENID_SIGNUP = true

[cron.update_checker]
ENABLED = true

[session]
PROVIDER = file

[log]
MODE = console
LEVEL = info
ROOT_PATH = /var/lib/gitea/log

[repository.pull-request]
DEFAULT_MERGE_STYLE = merge

[repository.signing]
DEFAULT_TRUST_MODEL = committer

[security]
INSTALL_LOCK = true
INTERNAL_TOKEN = {{ forgejo_secrets.security_internal_token }}
PASSWORD_HASH_ALGO = pbkdf2_hi

[oauth2]
JWT_SECRET = {{ forgejo_secrets.oauth2_jwt_secret }}

[git.timeout]
DEFAULT = 3600
MIGRATE = 6000
MIRROR  = 3000
CLONE   = 3000
PULL    = 3000
GC      = 600
