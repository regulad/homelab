# Managed by Ansible (clamonacc). Shadows the packages' unit of the same name in
# /usr/lib/systemd/system.
[Unit]
{% if clamonacc_clamd_local %}
Description=ClamAV on-access scanner, through the local clamd
{% else %}
Description=ClamAV on-access scanner, streaming to {{ clamonacc_clamd_host }}
{% endif %}
Documentation=man:clamonacc(8) man:clamd.conf(5) https://docs.clamav.net/
{% if clamonacc_clamd_local %}
# The packages' clamd, stopped and restarted with this one.
Requires=clamav-daemon.service
After=clamav-daemon.service
{% else %}
Wants=network-online.target
After=network-online.target
{% endif %}

[Service]
# In the foreground, clamonacc logs to stdout: detections as "<path>:
# <signature> FOUND", and each move as "<path>: moved to '<destination>'".
# --wait gives clamd 30 seconds to answer at start; after that, systemd
# restarts it.
{% if clamonacc_clamd_local %}
# --fdpass hands clamd each file's descriptor, so clamd, running as clamav,
# scans files only root can read.
{% endif %}
ExecStart=/usr/sbin/clamonacc --foreground --wait{{ ' --fdpass' if clamonacc_clamd_local else '' }} --config-file={{ clamonacc_config }}{{ (' --move=' ~ clamonacc_quarantine) if clamonacc_quarantine else '' }}
Restart=on-failure
RestartSec=30
# /run/clamonacc, the TemporaryDirectory its configuration names in place of
# /tmp, which clamonacc would otherwise refuse to watch.
RuntimeDirectory=clamonacc
# Large watched trees exhaust the default 1024 descriptors
# (https://github.com/Cisco-Talos/clamav/issues/1704).
LimitNOFILE=524288
# As upstream's unit, which stops it with SIGKILL.
KillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
