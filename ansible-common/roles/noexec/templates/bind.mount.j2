# Managed by Ansible (noexec). {{ item.0 }} bound over itself with noexec, so
# that nothing below it on its filesystem can be run or mapped executable.
[Unit]
Description=Bind {{ item.0 }} over itself, noexec
Documentation=man:systemd.mount(5) man:mount(8)

[Mount]
What={{ item.0 }}
Where={{ item.0 }}
Type=none
Options=bind,noexec
# Unbound at once, even while something holds the path open: bound over
# itself, the path shows the same files once unbound.
LazyUnmount=yes

[Install]
WantedBy=local-fs.target
