## Managed by Ansible (auditd). Writes and attribute changes of the watched
## paths (auditd_watches), and writes into auditd's logs by anything else, as
## rules for each syscall table: auditctl's -w is slower.
{% for arch in auditd_arches %}
{% for watch in auditd_watched %}
-a always,exit -F arch={{ arch }} -F {{ auditd_fields[watch.path] }}={{ watch.path }} -F perm=wa -k {{ watch.key }}
{% endfor %}
-a always,exit -F arch={{ arch }} -F dir=/var/log/audit -F perm=wa -F exe!=/usr/sbin/auditd -k audit-log
{% endfor %}
