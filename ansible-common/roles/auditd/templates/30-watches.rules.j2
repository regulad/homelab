## Managed by Ansible (auditd). Writes and attribute changes of the watched
## paths (auditd_watches), and writes into auditd's logs by anything else.
{% for watch in auditd_watched %}
-w {{ watch.path }} -p wa -k {{ watch.key }}
{% endfor %}
-a always,exit -F dir=/var/log/audit -F perm=wa -F exe!=/usr/sbin/auditd -k audit-log
