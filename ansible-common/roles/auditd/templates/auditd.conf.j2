# Managed by Ansible (auditd). The settings auditd.conf(5) names that differ
# from its defaults. Records go to {{ auditd_num_logs }} files of {{ auditd_max_log_file }} MB, at
# most {{ (auditd_root_share * 100) | int }}% of the root filesystem. When space runs low or the disk
# fails, auditd writes a line to syslog: it never mails, halts or suspends
# itself, as nothing would notice it had stopped recording.
local_events = yes
write_logs = yes
log_file = /var/log/audit/audit.log
log_group = root
log_format = ENRICHED
flush = INCREMENTAL_ASYNC
freq = 50
max_log_file = {{ auditd_max_log_file }}
num_logs = {{ auditd_num_logs }}
max_log_file_action = ROTATE
name_format = HOSTNAME
space_left = 10%
space_left_action = SYSLOG
admin_space_left = 5%
admin_space_left_action = SYSLOG
disk_full_action = ROTATE
disk_error_action = SYSLOG
