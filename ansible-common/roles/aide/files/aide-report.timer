# Managed by Ansible (aide).
[Unit]
Description=Daily AIDE report, at a time of the day of the host's own
Documentation=man:systemd.timer(5)

[Timer]
# Once a day, at a delay of up to a day from midnight that systemd derives from
# the host's machine ID and keeps, so that the hosts' checks spread across the
# day rather than meeting on shared storage.
OnCalendar=daily
RandomizedDelaySec=1d
FixedRandomDelay=true
# A check missed while the host was down runs once it is up.
Persistent=true

[Install]
WantedBy=timers.target
