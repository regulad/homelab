#!/usr/bin/python3
"""AIDE's daily report, without what the host's packages explain, and its baseline.

Managed by Ansible (aide).

aide-report: checks the host's files against the accepted baseline, leaves out
the changes its package manager vouches for, and mails root what remains.
aide-report --baseline: accepts the files as they are: a new database, and the
list of package-owned paths beside it, which later reports use to tell a path
an upgrade removed from one removed by hand.
aide-report --refresh PATH...: moves the baseline for those paths alone, the
files an Ansible run wrote, and leaves every other entry as it was.

A change is left out when:
- the path belongs to an installed package that vouches for it as it is now:
  rpm --verify finds nothing but its mtime, or dpkg --verify finds its contents
  intact and AIDE saw no change in its type, mode, ownership or other metadata
  dpkg does not record;
- the path is a symlink of a package, pointing at a file of a package that
  vouches for it;
- the path is gone, and the package that owned it at the baseline is no longer
  installed in that version, or it now lies below a path the configuration
  excludes (not below a new mount point: a filesystem mounted over a watched
  directory hides what was there, which stays in the report);
- the path is one of dpkg's records of a package under /var/lib/dpkg/info, its
  maintainer scripts among them, and the package was installed, upgraded or
  removed since the baseline, or the record's contents are unchanged;
- the path is a directory whose only changes are its timestamps, size, inode
  or link count, which follow from the entries in it, each listed itself.

dpkg records its files' contents alone, so on Debian and Ubuntu the mode of a
file a package installed since the baseline is not checked.

AIDE does not walk the container engines' image stores, which every pull
changes. aide-report runs each engine's own check of its image layers instead,
and mails what it finds with the report:
- Podman's, podman system check from Podman 5.2 and containers-storage check
  before it: each layer rebuilt from Podman's record of it and checked against
  its diff ID, and its files' type, owner, mode, size and mtime, with none
  added or removed. Neither compares setuid, setgid or sticky bits, extended
  attributes or symlink targets;
- Docker's, docker save of each image, on Docker's own image store: each
  layer's file contents, rebuilt and checked against its diff ID;
- none on Docker's containerd image store, which has no check of the layers
  containers run from.

Settings come from a JSON file, by default /etc/aide-report/settings.json.
"""

import argparse
import fcntl
import gzip
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time

SETTINGS = "/etc/aide-report/settings.json"

# AIDE's attributes, by the field names of its JSON report. A package's own
# file may show changes in its contents and in what follows from replacing a
# file; dpkg vouches for those alone, as it records only its files' contents.
CHECKSUMS = {
    "md5", "sha1", "sha256", "sha512", "rmd160", "tiger", "haval", "gost",
    "crc32", "crc32b", "whirlpool", "stribog256", "stribog512",
}
CONTENT = CHECKSUMS | {"size", "block_count", "growing_size"}
INCIDENTAL = {"access_time", "change_time", "modify_time", "inode", "link_count"}
# rpm --verify also checks mode, ownership, link target, type and
# capabilities; neither package manager records these.
UNRECORDED = {"acl", "selinux", "xattrs", "e2fsattrs"}
# dpkg's records of a package: /var/lib/dpkg/info/<package>[:<arch>].<kind>.
DPKG_INFO = re.compile(r"^/var/lib/dpkg/info/([^/]+)\.[A-Za-z0-9_-]+$")
# Lines of the report in each mail, at most.
MAIL_LINES = 400


def load(path):
    with open(path) as handle:
        return json.load(handle)


def unescape(field):
    """A mountinfo field, with its octal escapes decoded."""
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), field)


def regex(path):
    """A path as AIDE's regular expressions read it, literally."""
    out = []
    for char in path:
        if char.isalnum() or char in "/_-@+,:~%":
            out.append(char)
        elif char.isprintable() and not char.isspace():
            out.append("\\" + char)
        else:
            out.append("\\x%02x" % ord(char) if ord(char) < 256 else ".")
    return "".join(out)


def mount_points(settings):
    """Every mount point but the watched filesystems'."""
    points = set()
    with open("/proc/self/mountinfo") as handle:
        for line in handle:
            points.add(unescape(line.split()[4]))
    return points - set(settings["filesystems"])


def swap_files():
    files = set()
    try:
        with open("/proc/swaps") as handle:
            next(handle, None)
            for line in handle:
                fields = line.split()
                if len(fields) > 1 and fields[1] == "file":
                    files.add(unescape(fields[0]))
    except OSError:
        pass
    return files


def below(path, roots):
    """Whether path is one of roots, or below one; / is never such a root."""
    return any(root != "/" and (path == root or path.startswith(root + "/")) for root in roots)


def prune_prefix():
    """The negative rule that keeps AIDE out of a directory altogether: from
    0.19, "!" still walks the directory's children and "-" does not; before
    0.19, "!" does not."""
    result = subprocess.run(["aide", "--version"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, errors="replace")
    match = re.search(r"AIDE (\d+)\.(\d+)", result.stdout)
    return "!" if match and (int(match.group(1)), int(match.group(2))) < (0, 19) else "-"


def write_exclusions(settings):
    """Exclude, and keep AIDE out of: every mount point but the watched
    filesystems', the paths the settings exclude, and swap files."""
    prune = prune_prefix()
    lines = [
        "# Generated by aide-report at each run, each a rule AIDE does not walk past.",
        "# Every mount point but the watched filesystems', from /proc/self/mountinfo:",
    ]
    lines += ["%s%s(/|$)" % (prune, regex(point)) for point in sorted(mount_points(settings))]
    lines.append("# The paths the host's settings exclude:")
    lines += ["%s%s(/|$)" % (prune, regex(path.rstrip("/"))) for path in settings.get("excluded", [])]
    # The kernel rewrites swap files as it pages, and they can be gigabytes.
    lines.append("# Swap files, from /proc/swaps:")
    lines += ["%s%s$" % (prune, regex(swap)) for swap in sorted(swap_files())]
    path = settings["exclusions"]
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    with open(path + ".tmp", "w") as handle:
        handle.write("\n".join(lines) + "\n")
    os.replace(path + ".tmp", path)


def aide(settings, action):
    write_exclusions(settings)
    return subprocess.run(
        ["aide", "--config", settings["config"], action, "-A", "report_format=json"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, errors="replace")


class Packages:
    """The installed packages' paths, by the package manager the host has."""

    def __init__(self):
        self.rpm = os.path.exists("/usr/bin/rpm") and not os.path.exists("/usr/bin/dpkg")
        self.owner = {}
        self.installed = set()
        if self.rpm:
            out = subprocess.run(
                ["rpm", "-qa", "--qf", "[%{FILENAMES}\\t%{=NAME}-%{=VERSION}-%{=RELEASE}.%{=ARCH}\\n]"],
                stdout=subprocess.PIPE, text=True, errors="replace", check=True).stdout
            for line in out.splitlines():
                path, _, package = line.rpartition("\t")
                if path:
                    self.owner.setdefault(path, package)
                    self.installed.add(package)
        else:
            out = subprocess.run(
                ["dpkg-query", "-W", "-f", "${binary:Package}\\t${Version}\\n"],
                stdout=subprocess.PIPE, text=True, errors="replace", check=True).stdout
            versions = dict(line.split("\t", 1) for line in out.splitlines() if "\t" in line)
            info = "/var/lib/dpkg/info"
            for name in os.listdir(info):
                if not name.endswith(".list"):
                    continue
                package = name[:-5]
                version = versions.get(package) or versions.get(package.split(":")[0])
                if version is None:
                    continue
                package_id = "%s=%s" % (package, version)
                self.installed.add(package_id)
                with open(os.path.join(info, name), errors="replace") as handle:
                    for line in handle:
                        self.owner.setdefault(line.rstrip("\n"), package_id)

    def versions(self):
        """Each installed package's version, by the name dpkg's records use."""
        return dict(package_id.split("=", 1) for package_id in self.installed if "=" in package_id)

    def package(self, package_id):
        """The name the package manager verifies a package by."""
        return package_id if self.rpm else package_id.split("=", 1)[0]

    def unverified(self, paths):
        """The paths, of those given, that their packages do not vouch for."""
        packages = sorted({self.package(self.owner[p]) for p in paths if p in self.owner})
        failed = set()
        for start in range(0, len(packages), 200):
            batch = packages[start:start + 200]
            command = ["rpm", "--verify"] if self.rpm else ["dpkg", "--verify"]
            out = subprocess.run(command + batch, stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL, text=True, errors="replace").stdout
            for line in out.splitlines():
                match = re.match(r"^(missing|\S{8,9})\s+(?:[cdglr]\s)?\s*(/.*)$", line)
                if not match:
                    continue
                flags, path = match.groups()
                # Only rpm's mtime flag, T, leaves the file as the package has it.
                if self.rpm and flags != "missing" and not set(flags) - set(".T"):
                    continue
                failed.add(path)
        return failed


def entries(report, section):
    value = report.get(section) or {}
    if isinstance(value, list):
        return {path: "" for path in value}
    return dict(value)


def changed_attributes(report, path):
    return set((report.get("details") or {}).get(path, {}).keys())


def explain(report, packages, manifest, excluded=()):
    """The report's entries, split into those packages explain and the rest."""
    added = entries(report, "added")
    removed = entries(report, "removed")
    changed = entries(report, "changed")
    candidates = [p for p in list(added) + list(changed) if p in packages.owner]
    # A changed symlink of a package is left out when what it points at is a
    # file of a package that vouches for it, so its target is verified too.
    targets = {}
    for path, summary in list(added.items()) + list(changed.items()):
        if summary[:1] == "l" and path in packages.owner:
            targets[path] = os.path.realpath(path)
    unverified = packages.unverified(candidates + [t for t in targets.values() if t in packages.owner])
    kept = {"added": {}, "removed": {}, "changed": {}}
    explained = 0

    def vouched(path):
        if path not in packages.owner or path in unverified:
            return False
        attributes = changed_attributes(report, path)
        if packages.rpm:
            return not attributes & UNRECORDED
        return not attributes - CONTENT - INCIDENTAL

    def symlink_vouched(path):
        target = targets.get(path)
        return target in packages.owner and target not in unverified

    baseline_owner = manifest.get("owner", {})
    baseline_installed = manifest.get("installed") or list(set(baseline_owner.values()))
    now = packages.versions() if not packages.rpm else {}
    then = dict(i.split("=", 1) for i in baseline_installed if "=" in i) if not packages.rpm else {}

    def dpkg_record(path, section):
        match = None if packages.rpm else DPKG_INFO.match(path)
        if not match:
            return False
        name = match.group(1)
        if now.get(name) != then.get(name):
            return True
        return section == "changed" and not changed_attributes(report, path) - INCIDENTAL

    for section, items in (("added", added), ("changed", changed)):
        for path, summary in items.items():
            kind = summary[:1]
            attributes = changed_attributes(report, path)
            if kind == "d" and section == "changed" and not attributes - INCIDENTAL - {"size", "block_count"}:
                explained += 1
            elif dpkg_record(path, section):
                explained += 1
            elif vouched(path):
                explained += 1
            elif kind == "l" and symlink_vouched(path) and not attributes - INCIDENTAL - {"link_name", "size", "block_count"}:
                explained += 1
            else:
                kept[section][path] = summary
    for path, summary in removed.items():
        owner = baseline_owner.get(path)
        if ((owner is not None and owner not in packages.installed) or dpkg_record(path, "removed")
                or below(path, excluded)):
            explained += 1
        else:
            kept["removed"][path] = summary
    return kept, explained


def failed(command, result):
    return (["%s exited %d:" % (command, result.returncode)]
            + ["  " + line for line in result.stdout.splitlines()[-20:]] + [""])


def normal_priority():
    # The unit runs at the lowest priority, but Podman's check holds its layer
    # store while it reads, and a container starting waits for it. Lowering a
    # niceness needs CAP_SYS_NICE outside any user namespace, which root in an
    # unprivileged container lacks, so there the check stays at the unit's.
    try:
        os.setpriority(os.PRIO_PROCESS, 0, 0)
    except OSError:
        pass


def podman_check():
    """Podman's check of its image layers, as lines to mail, if it found damage."""
    if not shutil.which("podman"):
        return []
    version = subprocess.run(["podman", "version", "--format", "{{.Client.Version}}"],
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    numbers = tuple(int(number) for number in re.findall(r"\d+", version.stdout)[:2])
    if version.returncode != 0 or len(numbers) < 2:
        return failed("podman version", version)
    # Without flags, both check everything; --quick skips the layers' contents.
    if numbers >= (5, 2):
        argv, repair = ["podman", "system", "check"], "podman system check --repair"
    elif shutil.which("containers-storage"):
        argv, repair = ["containers-storage", "check"], "containers-storage check --repair"
    else:
        return ["Podman %s has no check of its image layers, and containers-storage, which has one, "
                "is not installed." % version.stdout.strip(), ""]
    result = subprocess.run(["ionice", "-t", "-c", "2", "-n", "4"] + argv, preexec_fn=normal_priority,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    if result.returncode == 0:
        return []
    return (["%s exited %d:" % (" ".join(argv), result.returncode)]
            + ["  " + line for line in result.stdout.splitlines()]
            + ["Once each is accounted for, %s removes the damaged images and layers," % repair,
               "which their services pull again as they start.", ""])


def docker_check():
    """Docker's check of its image layers, as lines to mail, if it found damage."""
    if not shutil.which("dockerd") or subprocess.run(
            ["systemctl", "is-active", "--quiet", "docker.service"]).returncode != 0:
        return []
    info = subprocess.run(["docker", "info", "--format", "{{json .DriverStatus}}"],
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    if info.returncode != 0:
        return failed("docker info", info)
    # The containerd image store keeps no record a layer can be rebuilt from.
    if "io.containerd.snapshotter.v1" in info.stdout:
        return []
    listed = subprocess.run(["docker", "image", "ls", "--no-trunc", "--format", "{{.ID}} {{.Repository}}:{{.Tag}}"],
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    if listed.returncode != 0:
        return failed("docker image ls", listed)
    names = {}
    for line in listed.stdout.splitlines():
        image, _, name = line.partition(" ")
        names.setdefault(image, []).append(name)
    damaged = []
    for image in sorted(names):
        # docker save rebuilds each layer from Docker's record of it and fails
        # on one whose contents no longer match its diff ID. Its output goes to
        # /dev/null as a stream: -o writes a file beside its target and renames it.
        result = subprocess.run(["docker", "save", image], stdout=subprocess.DEVNULL,
                                stderr=subprocess.PIPE, text=True, errors="replace")
        if result.returncode != 0:
            reason = (result.stderr.strip().splitlines() or ["exited %d" % result.returncode])[-1]
            damaged.append("  %s (%s): %s" % (", ".join(names[image]), image, reason))
    if not damaged:
        return []
    return (["docker save could not verify %d images:" % len(damaged)] + damaged
            + ["Once each is accounted for, remove the image and pull it again.", ""])


def mail(subject, lines):
    if len(lines) > MAIL_LINES:
        lines = lines[:MAIL_LINES] + ["", "... and %d more lines." % (len(lines) - MAIL_LINES)]
    subprocess.run(["mail", "-s", "AIDE on %s: %s" % (socket.getfqdn(), subject), "root"],
                   input="\n".join(lines) + "\n", text=True, check=True)


def describe(report, path, summary):
    details = (report.get("details") or {}).get(path, {})
    parts = []
    for attribute in sorted(details):
        values = details[attribute]
        if attribute in CHECKSUMS:
            parts.append(attribute)
        else:
            parts.append("%s %s -> %s" % (attribute, values.get("old", "?"), values.get("new", "?")))
    line = "  %s  %s" % (summary or "", path) if summary else "  " + path
    return line + ("\n      " + "; ".join(parts) if parts else "")


def save_kept(settings, kept, explained):
    """What the last report mailed, and how many changes it left out."""
    os.makedirs(settings["state"], mode=0o700, exist_ok=True)
    with open(os.path.join(settings["state"], "kept.json"), "w") as handle:
        json.dump({"time": time.time(), "explained": explained, "kept": kept}, handle)


def check(settings):
    subject, lines, status = check_files(settings)
    # AIDE does not walk the engines' image stores: each checks its own.
    images = podman_check() + docker_check()
    if images:
        subject = ", ".join(part for part in (subject, "container images") if part)
        lines = lines + ([""] if lines else []) + images
    if subject:
        mail(subject, lines)
    return status


def check_files(settings):
    """AIDE's report: a mail's subject, or none, its lines, and the exit status."""
    if not os.path.exists(settings["database"]):
        return "no baseline", ["There is no baseline at %s, so nothing was checked." % settings["database"],
                               "Create one with: " + settings["accept"]], 1
    result = aide(settings, "--check")
    if result.returncode >= 14 or result.returncode < 0:
        return "the check failed", ["aide exited %d." % result.returncode, ""] + result.stderr.splitlines()[-40:], 1
    if result.returncode == 0:
        save_kept(settings, {"added": {}, "removed": {}, "changed": {}}, 0)
        return None, [], 0
    try:
        report = json.loads(result.stdout)
    except ValueError as error:
        # AIDE escapes only backslashes, so a path with a quote or a newline in it
        # breaks the JSON: send the report as it is, unfiltered.
        return ("changes, unfiltered",
                ["AIDE's report is not valid JSON (%s), so nothing was left out." % error, ""]
                + result.stdout.splitlines(), 0)
    os.makedirs(settings["state"], mode=0o700, exist_ok=True)
    with open(os.path.join(settings["state"], "report.json"), "w") as handle:
        json.dump(report, handle)
    manifest = {}
    if os.path.exists(settings["manifest"]):
        with gzip.open(settings["manifest"], "rt") as handle:
            manifest = json.load(handle)
    kept, explained = explain(report, Packages(), manifest, [p.rstrip("/") for p in settings.get("excluded", [])])
    save_kept(settings, kept, explained)
    total = sum(len(items) for items in kept.values())
    if total == 0:
        return None, [], 0
    accepted = time.strftime("%Y-%m-%d %H:%M %Z", time.localtime(os.path.getmtime(settings["database"])))
    lines = ["%d changes since the baseline accepted %s that the host's packages do not explain;"
             % (total, accepted), "%d others they do were left out." % explained, ""]
    for section in ("added", "removed", "changed"):
        if kept[section]:
            lines.append("%s (%d):" % (section.capitalize(), len(kept[section])))
            lines.extend(describe(report, path, summary) for path, summary in sorted(kept[section].items()))
            lines.append("")
    lines += ["The full report is %s, and what it mailed %s." % (
                  os.path.join(settings["state"], "report.json"), os.path.join(settings["state"], "kept.json")),
              "Once each change is accounted for, accept the files as they are with:",
              "  " + settings["accept"]]
    return "%d changes" % total, lines, 0


def baseline(settings):
    result = aide(settings, "--init")
    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        sys.stderr.write("aide --init exited %d\n" % result.returncode)
        return 1
    packages = Packages()
    os.makedirs(settings["state"], mode=0o700, exist_ok=True)
    manifest = settings["manifest"]
    with gzip.open(manifest + ".tmp", "wt") as handle:
        json.dump({"owner": packages.owner, "installed": sorted(packages.installed)}, handle)
    os.replace(settings["database_new"], settings["database"])
    os.replace(manifest + ".tmp", manifest)
    print("Accepted the files as they are: %s" % settings["database"])
    return 0


def refresh(settings, paths):
    if not os.path.exists(settings["database"]):
        return 0
    write_exclusions(settings)
    # AIDE anchors --limit at the start of each path.
    limit = "(%s)$" % "|".join(regex(path) for path in sorted(set(paths)))
    result = subprocess.run(
        ["aide", "--config", settings["config"], "--update", "--limit", limit, "-A", "report_format=json"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, errors="replace")
    if result.returncode >= 14 or result.returncode < 0:
        sys.stderr.write(result.stderr)
        sys.stderr.write("aide --update exited %d\n" % result.returncode)
        return 1
    os.replace(settings["database_new"], settings["database"])
    print("Refreshed the baseline for %d paths." % len(set(paths)))
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    action = parser.add_mutually_exclusive_group()
    action.add_argument("--baseline", action="store_true", help="accept the files as they are")
    action.add_argument("--refresh", metavar="PATH", nargs="+", help="move the baseline for these paths alone")
    parser.add_argument("--settings", default=SETTINGS)
    args = parser.parse_args()
    settings = load(args.settings)
    os.umask(0o077)
    with open(settings["lock"], "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.baseline:
            return baseline(settings)
        if args.refresh:
            return refresh(settings, args.refresh)
        return check(settings)


if __name__ == "__main__":
    sys.exit(main())
