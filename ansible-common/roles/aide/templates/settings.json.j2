{{ {
  "config": aide_settings_dir ~ "/aide.conf",
  "exclusions": aide_exclusions,
  "filesystems": aide_filesystems,
  "excluded": (aide_exclude_paths + aide_exclude_paths_packages + aide_exclude_paths_group + aide_exclude_paths_host) | unique,
  "database": aide_database,
  "database_new": aide_database_new,
  "state": aide_state_dir,
  "manifest": aide_manifest,
  "lock": "/run/aide-report.lock",
  "accept": "cd " ~ (inventory_dir | dirname | basename) ~ " && ansible-playbook playbooks/maintenance.yml --tags aide-accept --limit " ~ inventory_hostname
} | to_nice_json }}
