# Managed by Ansible (restic).
{% set job = item.value %}
[Unit]
Description=restic backup of the Ceph RGW's buckets, through rclone's mount at {{ job.path }}
Wants=network-online.target
After=network-online.target {{ job.mount_service }}
Requires={{ job.mount_service }}

[Service]
Type=oneshot
EnvironmentFile={{ restic_env_file }}
Nice=10
TimeoutStartSec={{ restic_job_timeout }}
# A stale lock, left by a run that died, blocks every other command.
ExecStartPre=/usr/bin/restic unlock
# A FUSE mount's inode numbers are not stable, so unchanged files are found by
# their modification time and size alone.
ExecStart=/usr/bin/restic backup \
    --retry-lock={{ restic_retry_lock }} \
    --tag={{ job.tag }} \
    --one-file-system \
    --ignore-inode \
    -- {{ job.path }}
