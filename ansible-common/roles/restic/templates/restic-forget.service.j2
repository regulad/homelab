# Managed by Ansible (restic).
{% set job = item.value %}
[Unit]
Description=restic retention for every host's snapshots, then a prune
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ restic_env_file }}
Nice=10
TimeoutStartSec={{ restic_job_timeout }}
{% if job.mounts | default([]) %}
# A restic mount keeps the index it read at its start, which a prune leaves
# naming packs it removed, and their files then fail with "Key not found". The
# mounts stop for the run, and with them every unit that needs them; the units
# they took down start again after it, whether or not it succeeded.
ExecStartPre=/bin/sh -c 'systemctl list-units --type=service,mount --state=active --plain --no-legend | cut -d" " -f1 | sort >/run/restic-forget.active; systemctl stop {{ job.mounts | join(" ") }}; systemctl list-units --type=service,mount --state=active --plain --no-legend | cut -d" " -f1 | sort | comm -23 /run/restic-forget.active - >/run/restic-forget.stopped'
ExecStopPost=/bin/sh -c 'if [ -s /run/restic-forget.stopped ]; then systemctl start $$(cat /run/restic-forget.stopped); fi; rm -f /run/restic-forget.active /run/restic-forget.stopped'
{% endif %}
# A stale lock, left by a run that died, blocks every other command.
ExecStartPre=/usr/bin/restic unlock
# Each policy covers the snapshots with its tag, --tag= the untagged ones. A
# snapshot with a tag no policy names is never forgotten.
{% for policy in job.policies %}
ExecStart=/usr/bin/restic forget \
    --retry-lock={{ restic_retry_lock }} \
{% for period, count in policy.keep.items() %}
    --keep-{{ period }}={{ count }} \
{% endfor %}
    --tag={{ policy.tag }}
{% endfor %}
ExecStart=/usr/bin/restic prune --retry-lock={{ restic_retry_lock }}
