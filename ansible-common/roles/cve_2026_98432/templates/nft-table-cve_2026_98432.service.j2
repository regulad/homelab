# Managed by Ansible (cve_2026_98432).
[Unit]
Description=nftables table ip cve_2026_98432
Documentation=man:nft(8)
# Loaded before the network comes up, as nftables.service is.
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=null
ProtectSystem=full
ProtectHome=true
ExecStart=/usr/sbin/nft -f /etc/nft-tables/cve_2026_98432.nft
ExecReload=/usr/sbin/nft -f /etc/nft-tables/cve_2026_98432.nft
# Stopping deletes the table; one already gone is not an error.
ExecStop=-/usr/sbin/nft delete table ip cve_2026_98432

[Install]
WantedBy=sysinit.target
