# Managed by Ansible (clamav). clamonacc's settings, in clamd.conf's format.
{% if clamav_clamd_local %}
# The host's own clamd, through the packages' socket, configured apart in
# /etc/clamav/clamd.conf.
LocalSocket {{ clamav_clamd_socket }}
{% else %}
# No clamd runs on this host: clamonacc streams files to the shared one.
TCPAddr {{ clamav_clamd_host }}
TCPSocket {{ clamav_clamd_port }}
{% endif %}
# clamonacc will not watch the TemporaryDirectory its configuration names, /tmp
# unless set, so it names clamonacc's own runtime directory, which its unit
# creates.
TemporaryDirectory /run/clamonacc
{% for path in clamav_onaccess_watched %}
OnAccessIncludePath {{ path }}
{% endfor %}
{% for path in clamav_exclude_paths + ([clamav_quarantine] if clamav_quarantine else []) %}
OnAccessExcludePath {{ path }}
{% endfor %}
{% if clamav_clamd_local %}
# A local clamd's own user, whose temporary files in /tmp, written as it unpacks
# what it scans, would otherwise be scanned in turn.
OnAccessExcludeUname clamav
{% endif %}
{% for name in clamav_onaccess_exclude_unames %}
OnAccessExcludeUname {{ name }}
{% endfor %}
OnAccessExtraScanning {{ 'yes' if clamav_onaccess_extra_scanning else 'no' }}
OnAccessPrevention {{ 'yes' if clamav_onaccess_prevention else 'no' }}
OnAccessMaxFileSize {{ clamav_onaccess_max_file_size }}
