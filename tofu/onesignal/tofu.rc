# OpenTofu CLI configuration for this root, selected by prepare.sh through TF_CLI_CONFIG_FILE.
# regulad/onesignal is on no registry: the mirror is its only source, so direct leaves it out.
provider_installation {
  direct {
    exclude = ["registry.opentofu.org/regulad/onesignal"]
  }
  network_mirror {
    url     = "https://opentofu.regulad.xyz/"
    include = ["registry.opentofu.org/regulad/onesignal"]
  }
}
